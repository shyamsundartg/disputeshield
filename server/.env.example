# --- PayPal (leave blank to run on built-in demo data) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: set to verify webhook signatures (Developer Dashboard > your app > Webhooks)
PAYPAL_WEBHOOK_ID=
# Which data the app opens with when PayPal keys are set: true = demo data, false = live sandbox.
# Either way, the header switch lets you flip between them.
DEMO_MODE=false
# true = the live sandbox can be viewed and analyzed but not changed (for a public demo).
LIVE_READ_ONLY=false

# --- AI drafting (leave blank to use the built-in template writer) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

PORT=8787
