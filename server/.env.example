# --- PayPal (leave blank to run on built-in demo data) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: set to verify webhook signatures (Developer Dashboard > your app > Webhooks)
PAYPAL_WEBHOOK_ID=
# Force demo data even when PayPal keys are set (handy for recording the video)
DEMO_MODE=false

# --- AI drafting (leave blank to use the built-in template writer) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

PORT=8787
